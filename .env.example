# md-anything environment variables

# Optional: Enable remote AI fallbacks for image, audio, and video understanding.
# When set, md-anything can use OpenRouter APIs as an opt-in enhancement.
# Core workflows work without this — it is purely optional.
# OPENROUTER_API_KEY=

# Optional: Allow the MCP server to fetch private/localhost URLs.
# By default, the MCP server blocks private IPs and localhost for security.
# Set to "1" only when intentionally accessing local services.
# MDA_MCP_ALLOW_PRIVATE_URLS=1
